{
  "name": "frozen-goodies-and-more",
  "title": "Frozen Goodies and More",
  "description": "Adds Frozen Goodies support to several other mods and tweaks it a bit. Configurable!",
  "author": "QuingKhaos",
  "homepage": "https://discord.gg/SYmkaDjFCt",
  "version": "1.0.2",
  "factorio_version": "2.0",
  "dependencies": [
    "base >= 2.0.77",
    "space-age >= 2.0.77",

    "khaoslib >= 1.17.0",

    "frozen-goodies >= 0.0.1",
    "frozen-goodies-lib >= 1.0.0",

    "? aquilo-seabloom-algaculture >= 0.4.4",
    "? boompuff-agriculture >= 1.1.0",
    "? fluroflux >= 1.0.2",
    "? fulgora-coralmium-agriculture >= 1.2.7",
    "? lignumis >= 1.10.0",
    "? pelagos >= 0.59.0",

    "! FrozenFood",
    "! frozen-food-and-more",
    "! spoilage-solution",
    "! spoilage-solution-fork",
    "! spoilage-solution-and-more"
  ],
  "spoiling_required": true,
  "package": {
    "ignore": [
      "mod_info.yml",
      "**/*.md",
      "**/*.svg",
      "**/*.xcf"
    ]
  }
}
